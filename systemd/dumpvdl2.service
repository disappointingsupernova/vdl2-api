[Unit]
Description=dumpvdl2 VDL Mode 2 decoder
After=network.target
Documentation=https://github.com/szpajder/dumpvdl2

[Service]
Type=simple
User=vdl2
Group=vdl2

ExecStartPre=/bin/mkdir -p /var/lib/vdl2
ExecStart=/usr/local/bin/dumpvdl2 \
    --rtlsdr ${DUMPVDL2_DEVICE} \
    --station-id ${DUMPVDL2_STATION_ID} \
    --utc \
    --output decoded:json:file:path=/var/lib/vdl2/messages.jsonl \
    136.725M \
    136.775M \
    136.825M \
    136.875M \
    136.975M

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dumpvdl2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vdl2

EnvironmentFile=-/opt/vdl2-api/.env

[Install]
WantedBy=multi-user.target
