[Unit]
Description=VDL2 API — collector and REST service
After=network.target local-fs.target dumpvdl2.service
Wants=dumpvdl2.service
Documentation=https://github.com/disappointingsupernova/vdl2-api

[Service]
Type=simple
User=vdl2
Group=vdl2
WorkingDirectory=/opt/vdl2-api

EnvironmentFile=-/opt/vdl2-api/.env

# Defaults — override in /opt/vdl2-api/.env
Environment=VDL2_API_HOST=0.0.0.0
Environment=VDL2_API_PORT=5001

ExecStartPre=/bin/mkdir -p /var/lib/vdl2
ExecStart=/opt/vdl2-api/venv/bin/python -m uvicorn app.main:app \
    --host $VDL2_API_HOST \
    --port $VDL2_API_PORT \
    --no-access-log

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vdl2-api

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vdl2

[Install]
WantedBy=multi-user.target
