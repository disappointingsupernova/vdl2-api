# VDL2 API — environment configuration
# Copy to .env and adjust for your installation.

VDL2_API_HOST=0.0.0.0
VDL2_API_PORT=5001

VDL2_DATABASE=/var/lib/vdl2/vdl2.db
VDL2_SPOOL=/var/lib/vdl2/messages.jsonl
VDL2_STATE=/var/lib/vdl2/collector.state

VDL2_RETENTION_DAYS=30

# Comma-separated list of allowed CORS origins.
# Example: http://192.168.1.10:3000,http://dashboard.local
VDL2_CORS_ORIGINS=
