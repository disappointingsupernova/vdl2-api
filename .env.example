# VDL2 API — environment configuration
# Copy to .env and adjust for your installation.

VDL2_API_HOST=0.0.0.0
VDL2_API_PORT=5001

VDL2_DATABASE=/var/lib/vdl2/vdl2.db
VDL2_SPOOL=/var/lib/vdl2/messages.jsonl

VDL2_RETENTION_DAYS=30

# Comma-separated list of allowed CORS origins.
# Example: http://192.168.1.10:3000,http://dashboard.local
VDL2_CORS_ORIGINS=

# API key authentication — leave empty to disable.
# When set, all requests must include the header: X-API-Key: <value>
# Generate a key with: python3 -c "import secrets; print(secrets.token_hex(32))"
VDL2_API_KEY=

# ---------------------------------------------------------------------------
# dumpvdl2 settings (used by systemd/dumpvdl2.service)
# ---------------------------------------------------------------------------

# RTL-SDR device serial number.
# If you have only one RTL-SDR dongle you can use 0 (index) instead of the
# serial number. If you have multiple dongles on the same host (e.g. one for
# VDL2 and one for ADS-B) you must use the serial number to pin each service
# to the correct device.
#
# Find your serial numbers with:
#   rtl_test -t
# or:
#   rtl_eeprom
#
DUMPVDL2_DEVICE=0

# Station identifier included in every decoded message.
# Use a short unique name for your receiver site, e.g. your hostname.
DUMPVDL2_STATION_ID=my-vdl2-station
